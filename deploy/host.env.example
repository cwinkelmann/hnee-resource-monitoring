# deploy/host.env.example  ->  ~/.config/resourcemonitor/host.env   (mode 0644)
#
# Per-host settings for run-resourcemonitor.sh, so one unit file fits every
# machine. Plain configuration, not a secret: the Slack webhook lives in
# ~/.config/resourcemonitor/env at mode 0600 and is never named here.
#
# Shell syntax, since the wrapper sources it. No spaces around "=", no quotes
# needed for these values.

# The LAN address the dashboard listens on. Without it the server binds
# 127.0.0.1 only -- deliberate, so a new host is never exposed by accident.
#   carrot 10.188.1.1   olive 10.188.2.1   t14 192.168.188.88
RESOURCEMONITOR_BIND=10.188.1.1

# Port for the dashboard and the booking API.
RESOURCEMONITOR_PORT=8765

# Interpreter to run. Leave it unset to take ~/miniconda3/envs/resourcemonitor
# when that exists and plain python3 otherwise; the code is stdlib-only, so any
# 3.10+ interpreter works.
RESOURCEMONITOR_PYTHON=

# Seconds between collector polls. Energy is the sum of power x this interval,
# so changing it changes the resolution of every kWh figure from then on.
RESOURCEMONITOR_INTERVAL=60
